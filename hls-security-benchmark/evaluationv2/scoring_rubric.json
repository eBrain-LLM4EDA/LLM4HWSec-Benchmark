{
  "version": "1.0",
  "benchmark_name": "HLS Security-Aware Code Generation (Arda)",
  "dimensions": {
    "detection_rate": {
      "weight": 0.25,
      "description": "CWE violation detection rate",
      "scoring": {
        "formula": "(true_positives / expected_vulnerabilities) * cwe_accuracy_factor",
        "cwe_accuracy_factor": "correctly_classified / total_reported",
        "false_positive_penalty": -0.05
      }
    },
    "flow_correctness": {
      "weight": 0.25,
      "description": "Information flow / access control / side-channel correctness",
      "rubrics": {
        "information_flow_tracking": {
          "taint_type_defined": 0.2,
          "labels_assigned_correctly": 0.2,
          "propagation_arithmetic": 0.2,
          "propagation_lookup": 0.1,
          "declassification_gated": 0.15,
          "no_untracked_flows": 0.15
        },
        "access_control": {
          "policy_function_implemented": 0.25,
          "policy_matches_spec": 0.25,
          "safe_default_on_deny": 0.2,
          "denial_feedback": 0.15,
          "no_bypass_mechanisms": 0.15
        },
        "side_channel": {
          "no_secret_dependent_branches": 0.3,
          "fixed_iteration_count": 0.2,
          "constant_ops_per_iteration": 0.2,
          "branchless_conditionals": 0.2,
          "hls_fixed_pipeline_pragmas": 0.1
        },
        "resource_isolation": {
          "separate_storage": 0.25,
          "sanitize_on_transition": 0.25,
          "stale_data_cleared": 0.2,
          "no_cross_domain_timing": 0.15,
          "zeroization_available": 0.15
        }
      }
    },
    "synthesis_pass": {
      "weight": 0.2,
      "description": "HLS synthesis compatibility",
      "static_checks": [
        "no_dynamic_allocation",
        "no_recursion",
        "no_system_calls",
        "no_exceptions",
        "no_virtual_functions",
        "static_loop_bounds",
        "valid_hls_pragmas",
        "hls_compatible_types"
      ]
    },
    "functional_equivalence": {
      "weight": 0.15,
      "description": "I/O equivalence with insecure version (on shared ports)"
    },
    "security_completeness": {
      "weight": 0.15,
      "description": "Coverage of all security spec properties",
      "rubric": {
        "required_properties_addressed": 0.4,
        "prohibited_patterns_avoided": 0.3,
        "defense_in_depth": 0.15,
        "security_comments": 0.15
      }
    }
  },
  "grade_bands": {
    "A": [0.90, 1.00],
    "B": [0.75, 0.89],
    "C": [0.60, 0.74],
    "D": [0.40, 0.59],
    "F": [0.00, 0.39]
  },
  "difficulty_weights": {
    "easy": 1.0,
    "medium": 1.5,
    "hard": 2.0
  },
  "examples": [
    {"id": "01_aes_ift",              "difficulty": "medium", "domain": "information_flow_tracking", "cwes": ["CWE-200"]},
    {"id": "02_memory_access_control","difficulty": "easy",   "domain": "access_control",            "cwes": ["CWE-284"]},
    {"id": "03_constant_time_compare","difficulty": "easy",   "domain": "side_channel",              "cwes": ["CWE-208"]},
    {"id": "04_key_schedule_isolation","difficulty": "medium", "domain": "resource_isolation",        "cwes": ["CWE-1189"]},
    {"id": "05_dma_access_policy",    "difficulty": "medium", "domain": "access_control",            "cwes": ["CWE-284", "CWE-1234"]},
    {"id": "06_sha256_ift",           "difficulty": "hard",   "domain": "information_flow_tracking", "cwes": ["CWE-200"]},
    {"id": "07_register_file_rbac",   "difficulty": "hard",   "domain": "access_control",            "cwes": ["CWE-284", "CWE-1191"]},
    {"id": "08_modexp_side_channel",  "difficulty": "hard",   "domain": "side_channel",              "cwes": ["CWE-208"]},
    {"id": "09_fifo_data_sanitization","difficulty": "easy",  "domain": "resource_isolation",        "cwes": ["CWE-226", "CWE-1271"]},
    {"id": "10_bus_arbiter_isolation", "difficulty": "hard",   "domain": "resource_isolation",        "cwes": ["CWE-1189"]}
  ]
}
