library(cells) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit(1, pf);
  leakage_power_unit : "1nW";

  cell(NAND4) {
    area : 4;
    pin(A) { direction : input; capacitance : 0.002; }
    pin(B) { direction : input; capacitance : 0.002; }
    pin(C) { direction : input; capacitance : 0.002; }
    pin(D) { direction : input; capacitance : 0.002; }
    pin(Y) { direction : output; function : "!(A & B & C & D)"; timing() { cell_rise : 0.1; cell_fall : 0.1; rise_transition : 0.05; fall_transition : 0.05; } }
  }

  cell(NOR2) {
    area : 2;
    pin(A) { direction : input; capacitance : 0.001; }
    pin(B) { direction : input; capacitance : 0.001; }
    pin(Y) { direction : output; function : "!(A | B)"; timing() { cell_rise : 0.08; cell_fall : 0.08; rise_transition : 0.04; fall_transition : 0.04; } }
  }

  cell(INV) {
    area : 1;
    pin(A) { direction : input; capacitance : 0.001; }
    pin(Y) { direction : output; function : "!A"; timing() { cell_rise : 0.05; cell_fall : 0.05; rise_transition : 0.03; fall_transition : 0.03; } }
  }

  cell(XOR2) {
    area : 3;
    pin(A) { direction : input; capacitance : 0.0015; }
    pin(B) { direction : input; capacitance : 0.0015; }
    pin(Y) { direction : output; function : "A ^ B"; timing() { cell_rise : 0.12; cell_fall : 0.12; rise_transition : 0.06; fall_transition : 0.06; } }
  }

  cell(DFF) {
    area : 6;
    ff(IQ, IQN) { clocked_on : "CLK"; next_state : "D"; }
    pin(CLK) { direction : input; capacitance : 0.003; clock : true; }
    pin(RST_N) { direction : input; capacitance : 0.002; }
    pin(EN) { direction : input; capacitance : 0.002; }
    pin(D) { direction : input; capacitance : 0.002; }
    pin(Q) { direction : output; function : "IQ"; timing() { cell_rise : 0.15; cell_fall : 0.15; rise_transition : 0.08; fall_transition : 0.08; } }
  }
}