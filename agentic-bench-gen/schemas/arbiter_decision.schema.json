{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retain_case",
    "observed_mutation_score",
    "artifact_to_revise",
    "root_cause",
    "rationale",
    "revision_instructions"
  ],
  "properties": {
    "retain_case": {
      "type": "boolean"
    },
    "observed_mutation_score": {
      "type": "number",
      "description": "Copy the exact numeric mutation_score value from the validation report verbatim — do not round or estimate"
    },
    "artifact_to_revise": {
      "type": "string",
      "enum": [
        "none",
        "specification",
        "case_artifacts",
        "evaluation_framework",
        "mutants"
      ]
    },
    "root_cause": {
      "type": "string",
      "enum": [
        "none",
        "specification_issue",
        "artifact_issue",
        "evaluation_issue",
        "validation_issue",
        "mutation_issue"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "revision_instructions": {
      "type": "string"
    }
  }
}