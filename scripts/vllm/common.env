# Shared defaults for every serve_*.sh script in this directory.
# Override anything by exporting the variable before running a script, e.g.:
#   VLLM_API_KEY=my-secret PORT=9001 ./serve_qwen2.5_coder_7b.sh
#
# This file is sourced, not executed - no shebang, no `set -e`.

# --- Python environment -----------------------------------------------------
# Name of the conda env created/reused by lib.sh's setup_env(). Override with
# either this env var or the `--conda-env NAME` flag on any serve_*.sh (the
# flag wins if both are given). If the env already exists it is reused as-is
# (and vLLM install is skipped if already present in it) - nothing is
# recreated or overwritten.
ENV_NAME="${ENV_NAME:-hwsec-vllm}"
# Python version for a fresh conda env.
PYTHON_VERSION="${PYTHON_VERSION:-3.11}"
# Leave empty to install the latest vLLM; set e.g. "0.6.6" to pin a version
# for reproducibility once you've settled on one.
VLLM_VERSION="${VLLM_VERSION:-}"

# --- Hugging Face cache ------------------------------------------------------
# Point this at scratch/project storage, NOT $HOME - model weights are large
# and HPC home directories are almost always quota-limited.
export HF_HOME="${HF_HOME:-$PWD/.hf_cache}"
export HF_HUB_ENABLE_HF_TRANSFER=1

# --- Server defaults (each serve_*.sh script sets its own model/port/etc,
#     these are just the knobs that are the same across all four) -----------
VLLM_API_KEY="${VLLM_API_KEY:-local-vllm-key}"
GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.90}"
DTYPE="${DTYPE:-bfloat16}"
TP_SIZE="${TP_SIZE:-1}"
LOG_DIR="${LOG_DIR:-$PWD/logs}"
# Prefer the FlashAttention backend - the standard, well-tested choice for
# the plain dense Qwen2/Llama-style 7-8B models these scripts serve. Note this
# alone does NOT avoid the "AssertionError: Found N libcudnn.so.x in
# nvidia-cudnn-cuXX" crash some shared/reused conda envs hit (vLLM probes
# every backend's importability, including FlashInfer, before honoring this);
# lib.sh's fix_cudnn_duplicates() is what actually fixes that, by keeping
# only the nvidia-cudnn-cu* package matching torch's CUDA build.
export VLLM_ATTENTION_BACKEND="${VLLM_ATTENTION_BACKEND:-FLASH_ATTN}"
# Skip vLLM's torch.compile compilation pipeline (CUDA graphs / graph
# fusion). Some vLLM builds unconditionally import flashinfer.comm while
# building that compiled backend (AllReduceFusionPass), independent of TP
# size or the attention backend above - and some flashinfer releases ship
# code with a genuine Python-version incompatibility there
# ("TypeError: type 'array.array' is not subscriptable"). --enforce-eager
# skips the whole compiled path, so that import is never reached. Fine for
# benchmark-style serving (low concurrency, correctness over raw throughput);
# set ENFORCE_EAGER=0 to re-enable compilation once/if that's fixed upstream.
ENFORCE_EAGER="${ENFORCE_EAGER:-1}"
# Disable FlashInfer's top-k/top-p sampling kernels - a THIRD, independent
# FlashInfer usage beyond the attention backend and compile-pass fixes above
# (active regardless of VLLM_ATTENTION_BACKEND or --enforce-eager). Unlike
# attention, FlashInfer doesn't ship this kernel precompiled; vLLM JIT-
# compiles it via nvcc on first sample, targeting the GPU's real compute
# capability (e.g. compute_90a for H100). If the `nvcc` on PATH is older than
# the GPU needs (common on HPC where a stale system CUDA toolkit precedes a
# newer one), that JIT compile fails with "nvcc fatal: Unsupported gpu
# architecture". This skips FlashInfer here entirely in favor of vLLM's
# native PyTorch/Triton sampler (verified against vllm's
# topk_topp_sampler.py: envs.VLLM_USE_FLASHINFER_SAMPLER=0 short-circuits
# flashinfer_sampler_supported() before any JIT compile is attempted). Set to
# 1 to re-enable once nvcc on PATH matches your GPU's CUDA requirements.
export VLLM_USE_FLASHINFER_SAMPLER="${VLLM_USE_FLASHINFER_SAMPLER:-0}"
